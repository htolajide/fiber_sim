# vis.mac - Fully headless mode for Docker
# Compatible with Geant4 v11 and TSG_OFFSCREEN

/control/macroPath /home/geant4/work

# Open offscreen graphics system (no GUI required)
/vis/open TSG_OFFSCREEN

# Create scene and viewer
/vis/scene/create
/vis/sceneHandler/attach
/vis/viewer/create

# Draw geometry
/vis/drawVolume
/vis/viewer/set/style surface
/vis/viewer/set/background white

# Set viewpoint
/vis/viewer/set/viewpointThetaPhi 90 0 deg
/vis/viewer/zoom 1.0

# Add reference elements
/vis/scene/add/axes 0 0 0 1 mm 
/vis/scene/add/trajectories smooth
/vis/scene/endOfEventAction accumulate

# Finalize and save
/vis/viewer/flush
/vis/viewer/update
/vis/viewer/save /home/geant4/work/fiber_geometry.png

# Optional: export scene to WRL
# /vis/scene/export /home/geant4/work/fiber_scene.wrl  # Disabled: command not available with TSG_OFFSCREEN